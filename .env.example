# IP privada o DNS de la EC2 Database (sin http://).
# Reemplazar antes de arrancar servicios.
DATABASE_HOST=REEMPLAZAR_IP_PRIVADA_DATABASE
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# HOST del catalogo en PostgreSQL; opcional si se setea DATABASE_HOST.
POSTGRES_HOST=
POSTGRES_PORT=5432
# Contraseña tecnica de catalog_app (igual que en infrastructure/.env).
CATALOG_POSTGRES_PASSWORD=CAMBIAR_CATALOGO
# Pedidos en MySQL (igual que en infrastructure/.env).
MYSQL_PORT=3307
MYSQL_PASSWORD=CAMBIAR_PEDIDOS
# Inventario en MongoDB (igual que en infrastructure/.env).
INVENTORY_MONGO_URI=mongodb://inventory_app:CAMBIAR_INVENTARIO@${DATABASE_HOST}:27017/hardtech_inventory
# HOST individuales opcionales: POSTGRES_HOST, MYSQL_HOST.
# URLs por nombre solo si estos servicios corren juntos. Para otra EC2 usar IP privada:puerto.
CATALOG_SERVICE_URL=http://catalog-service:8002
INVENTORY_SERVICE_URL=http://inventory-service:8006
ORDER_SERVICE_URL=http://order-service:8003
CATALOG_SERVICE_PORT=8002
INVENTORY_SERVICE_PORT=8006
ORDER_SERVICE_PORT=8003
COMPATIBILITY_SERVICE_PORT=8004
ANALYTICS_SERVICE_PORT=8005
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
S3_EVENTS_PREFIX=raw/events/
S3_DATA_PREFIX=analytics/
GLUE_DATABASE=hardtech_analytics
ATHENA_WORKGROUP=hardtech-analytics
ATHENA_OUTPUT_LOCATION=
ATHENA_QUERY_TIMEOUT_SECONDS=30